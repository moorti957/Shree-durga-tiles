NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# Use a managed MongoDB URI in production; localhost is development-only.
MONGODB_URI=mongodb://localhost:27017/shree-durga-tiles
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000/api
ENABLE_LEGACY_COMMERCE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Firebase Cloud Messaging credentials for admin push delivery.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
LOG_LEVEL=info

# Bootstrap the first owner with `npm run admin:bootstrap` from backend.
# Development-only password reset: update ADMIN_PASSWORD, then run `npm run admin:reset-password`.
ADMIN_NAME=Store Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=
